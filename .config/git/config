[user]
	name = Nora Heydecker
	email = 180162335+nora-heydecker-axa@users.noreply.github.com
[alias]
	st = status
	rc = "rebase --continue"
	ra = "rebase --abort"
        mc = "merge --continue"
        ma = "merge --abort"
	sw = !git checkout $(git branch --format \"%(refname:lstrip=2)\" | fzf)
	fpush = "push --force-with-lease"
	amend = commit --amend --no-edit
	detach = "!git checkout \"$(git rev-parse HEAD)\""
	hardupdate = "!git fetch && git reset --hard \"origin/$(git rev-parse --abbrev-ref HEAD)\""
	hu = hardupdate
	c = checkout
	m = merge
	pl = pull
        p = push

[core]
	autocrlf = false
	editor = "nvim"
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	attributesfile = /Users/nora/.gitattributes

[diff "bin"]
    # Use `hexdump` to diff binary files
    textconv = hexdump -v -C
[merge]
    # Include summaries of merged commits in newly created merge commit messages
    log = true

[push]
	autoSetupRemote = true
	default = simple

[init]
    defaultbranch = main

[merge]
	conflictstyle = "zdiff3"

[pull]
    ff = only
[advice]
	detachedHead = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P
[credential]
	manager = osxkeychain

[diff "ansible-vault"]
    command = ansible-vault-diff
